<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UserSecretsId>dotnet-WinFIMLog-393DD967-2EB1-49CF-AC41-ECF289DC3BB8</UserSecretsId>
        <StartupObject>WinFIMLog.Program</StartupObject>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\Assets\fim.ico</ApplicationIcon>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PublishAot>true</PublishAot>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    </PropertyGroup>


    <PropertyGroup>
        <MeziantouAnalysisMode>all-warnings</MeziantouAnalysisMode>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="fim-log.db" />
        <None Remove="fim.db" />
        <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="LiteDB" Version="5.0.21" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.177">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" ExcludeAssets="build;buildTransitive" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.11" />
        <PackageReference Include="NUlid" Version="1.7.3" />
        <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
        <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
        <PackageReference Include="TBC.Common.Configuration.Registry" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\scripts\install-event-channels.ps1" Link="install-event-channels.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\..\scripts\uninstall-event-channels.ps1" Link="uninstall-event-channels.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NtfsReader\src\NtfsReader\NtfsReader.csproj" />
    </ItemGroup>
</Project>
